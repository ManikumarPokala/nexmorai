datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum MigrationStatus {
  DISCOVERED
  ANALYZING
  READY_FOR_MIGRATION
  IN_PROGRESS
  VALIDATING
  COMPLETED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Organization {
  id String @id @default(cuid())
  name String
  projects Project[]
  createdAt DateTime @default(now())
}

model Project {
  id String @id @default(cuid())
  name String
  orgId String
  organization Organization @relation(fields: [orgId], references: [id])
  assets BIAsset[]
  sourceType String
  targetType String
  createdAt DateTime @default(now())
}

model BIAsset {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id])

  name String
  externalId String?
  type String

  status MigrationStatus @default(DISCOVERED)
  riskScore Int @default(0)
  riskLevel RiskLevel @default(LOW)
  complexityScore Int @default(0)
  businessCriticality Int @default(0)

  metadata Json? @default("{}")
  validationLogs ValidationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ValidationLog {
  id String @id @default(cuid())
  assetId String
  asset BIAsset @relation(fields: [assetId], references: [id])
  passed Boolean
  details Json
  runAt DateTime @default(now())
}
